function tableOf(lang: string): string[] {
  if (lang === 'zh-Hant') {
    return HANT;
  }
  if (lang === 'en') {
    return EN;
  }
  if (lang === 'ja') {
    return JA;
  }
  if (lang === 'fr') {
    return FR;
  }
  if (lang === 'es') {
    return ES;
  }
  if (lang === 'ko') {
    return KO;
  }
  return KEYS;
}

export function translate(lang: string, source: string): string {
  if (lang === 'zh-Hans' || source.length === 0) {
    return source;
  }
  const table = tableOf(lang);
  for (let i = 0; i < KEYS.length; i++) {
    if (KEYS[i] === source) {
      const value = table[i];
      if (value.length > 0) {
        return value;
      }
      return source;
    }
  }
  return source;
}

export function resolveLanguage(pref: string, systemLang: string): string {
  if (pref === 'zh-Hans' || pref === 'zh-Hant' || pref === 'en' || pref === 'ja' || pref === 'fr' || pref === 'es' || pref === 'ko') {
    return pref;
  }
  return mapSystemLanguage(systemLang);
}

export function mapSystemLanguage(systemLang: string): string {
  const s = systemLang.toLowerCase();
  if (s.indexOf('zh') >= 0) {
    if (s.indexOf('hant') >= 0 || s.indexOf('tw') >= 0 || s.indexOf('hk') >= 0 || s.indexOf('mo') >= 0) {
      return 'zh-Hant';
    }
    return 'zh-Hans';
  }
  if (s.indexOf('ja') === 0) {
    return 'ja';
  }
  if (s.indexOf('fr') === 0) {
    return 'fr';
  }
  if (s.indexOf('es') === 0) {
    return 'es';
  }
  if (s.indexOf('ko') === 0) {
    return 'ko';
  }
  if (s.indexOf('en') === 0) {
    return 'en';
  }
  return 'en';
}

export function replyLanguageName(lang: string): string {
  if (lang === 'zh-Hant') {
    return 'Traditional Chinese';
  }
  if (lang === 'en') {
    return 'English';
  }
  if (lang === 'ja') {
    return 'Japanese';
  }
  if (lang === 'fr') {
    return 'French';
  }
  if (lang === 'es') {
    return 'Spanish';
  }
  if (lang === 'ko') {
    return 'Korean';
  }
  return 'Simplified Chinese';
}
